#!name = 国家电网签到金
#!desc = 网上国网(95598)签到金每日签到,自动捕获凭证、内置国密解密,通知展示账号昵称/今日签到金/连签天数/总额,累计签到达档位自动抽奖
#!author = ZahicX
#!icon = https://raw.githubusercontent.com/ZahicX/Script/main/icon/sgcc.png
#!system = iOS,iPadOS,tvOS,macOS
#!tag = 签到,工具
#!type = normal
#!date = 2026年10月9日01:34:33

# ---------------------------------------------------------------
# [Argument] 参数
#   token_switch: 捕获凭证开关,默认打开
#   cron_switch:  定时签到开关,默认关闭
#   cron_expr:    Cron 表达式,可自由修改签到时间
# ---------------------------------------------------------------
[Argument]
token_switch = switch,true,tag=获取凭证,desc=打开后,在 App 内打开积分签到页即自动捕获/更新凭证(需配合 MITM)
cron_switch = switch,false,tag=Cron签到,desc=打开后,按下方 Cron 时间自动遍历已捕获账户执行签到
cron_expr = input,"30 8 * * *",tag=Cron签到时间,desc=Cron 表达式(分 时 日 月 周),如 "30 8 * * *" 表示每天 08:30,"30 0 * * *" 表示每天 00:30;格式错误则定时任务不执行

[Script]
# 凭证捕获:打开 App 积分签到页时自动捕获鉴权头与签到/总额/记录请求体;打开
# 「我的」页时补全资料请求体;均存入 $persistentStore(key=sgcc_accounts);requires-body 必须开启
http-request ^https://csc-service\.sgcc\.com\.cn:28630\/.+\/member\/ script-path=https://raw.githubusercontent.com/ZahicX/Script/main/SGCC/SGCC_checkin.js,timeout=10,requires-body=true,enable={token_switch},tag=国家电网凭证捕获

# 定时签到:按 cron_expr 参数指定的时间执行,遍历所有已捕获账户依次签到,汇总为一条通知
# (签到金金额/连签天数/总额均来自脚本内置国密解密的服务端数据)
cron {cron_expr} script-path=https://raw.githubusercontent.com/ZahicX/Script/main/SGCC/SGCC_checkin.js,timeout=300,enable={cron_switch},tag=国家电网定时签到

# ---------------------------------------------------------------
# [Mitm] HTTPS 必须解密,否则凭证捕获规则不生效
# t(token) 失效后签到会通知提醒;重新打开 App 积分签到页即可自动重抓(实测有效期数天)
# ---------------------------------------------------------------
[Mitm]
hostname = csc-service.sgcc.com.cn
